# AI Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Admin Authentication Token (to protect POST /model/train)
ADMIN_SECRET_TOKEN=change-me-to-a-secure-admin-token

# Groq Cloud API Configuration (for Chatbot)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase Credentials (Privileged server-side key or Anon Key)
# Found at: https://supabase.com/dashboard/project/<project-id>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here

# Prediction Thresholds & Policies
AT_RISK_THRESHOLD=50.0
HIGH_RISK_PROBABILITY=0.65
MODERATE_RISK_PROBABILITY=0.35
